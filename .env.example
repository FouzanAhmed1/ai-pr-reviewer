# Copy to .env (or export in your shell) and fill in. Never commit real values.
# The GitHub Action passes these as inputs instead; see action.yml.

# Required. Personal access token (classic, repo scope) or GITHUB_TOKEN from Actions.
GITHUB_TOKEN=

# Required. API key for your OpenAI-compatible LLM provider.
LLM_API_KEY=

# Optional. Base URL of the chat completions endpoint. Any OpenAI-compatible
# provider works (OpenAI, OpenRouter, Ollama, vLLM, etc.).
LLM_BASE_URL=https://api.openai.com/v1

# Optional. Model name sent to the endpoint.
LLM_MODEL=gpt-4o-mini

# Optional. Max estimated tokens per diff chunk sent to the LLM (chars/4 estimate).
MAX_CHUNK_TOKENS=4000
